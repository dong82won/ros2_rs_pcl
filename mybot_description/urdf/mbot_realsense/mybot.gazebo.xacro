<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="wheel_separation" value="0.58306"/>
    <xacro:property name="wheel_radius" value="${0.32918 / 2.0}"/>

    <!-- 4륜 스키드 스티어 최적화 마찰 계수 -->
    <!-- mu1: 구동 바퀴 회전 방향 마찰력 (구동력 전달) -->
    <!-- mu2: 구동 바퀴 축 방향(횡방향) 마찰력 (제자리 선회 슬립 보장) -->
    <xacro:property name="wheel_mu1" value="1.0"/>
    <xacro:property name="wheel_mu2" value="0.05"/>

    <xacro:property name="base_mu1" value="0.05"/>
    <xacro:property name="base_mu2" value="0.05"/>
    <xacro:property name="update_rate" value="30"/>

    <!-- =================================================================== -->
    <!-- 1. 재질, 마찰력 및 물리 접촉 속성                                   -->
    <!-- =================================================================== -->
    <xacro:macro name="wheel_gazebo" params="prefix">
        <gazebo reference="${prefix}_wheel_link">
            <mu1>${wheel_mu1}</mu1>
            <mu2>${wheel_mu2}</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1>
            <self_collide>false</self_collide>
            <visual name="${prefix}_wheel_visual">
                <material>
                    <ambient>0.1 0.1 0.1 1.0</ambient>
                    <diffuse>0.1 0.1 0.1 1.0</diffuse>
                    <specular>0.0 0.0 0.0 1.0</specular>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>

    <gazebo reference="base_link">
        <mu1>${base_mu1}</mu1>
        <mu2>${base_mu2}</mu2>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="lidar_link">
        <visual name="lidar_visual">
            <material>
                <ambient>0.0 0.0 0.0 1.0</ambient>
                <diffuse>0.0 0.0 0.0 1.0</diffuse>
                <specular>0.0 0.0 0.0 1.0</specular>
            </material>
        </visual>
    </gazebo>

    <!-- =================================================================== -->
    <!-- 2. 차동 구동(Diff Drive) 시스템 플러그인                            -->
    <!-- =================================================================== -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <!-- 좌측 구동축 조인트 바인딩 -->
            <left_joint>front_left_wheel</left_joint>
            <left_joint>rear_left_wheel</left_joint>

            <!-- 우측 구동축 조인트 바인딩 -->
            <right_joint>front_right_wheel</right_joint>
            <right_joint>rear_right_wheel</right_joint>

            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <!-- 물리 엔진 회전 토크 및 가속도 상한선 설정 -->
            <max_wheel_torque>50.0</max_wheel_torque>
            <max_linear_acceleration>2.0</max_linear_acceleration>
            <max_angular_acceleration>4.0</max_angular_acceleration>

            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>${update_rate}</odom_publish_frequency>
        </plugin>
    </gazebo>

    <!-- =================================================================== -->
    <!-- 3. 관절 상태(Joint State) 시스템 플러그인                           -->
    <!-- =================================================================== -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>front_left_wheel</joint_name>
            <joint_name>front_right_wheel</joint_name>
            <joint_name>rear_left_wheel</joint_name>
            <joint_name>rear_right_wheel</joint_name>
        </plugin>
    </gazebo>

    <!-- =================================================================== -->
    <!-- 4. 라이다 센서 (GPU LiDAR - 절대 토픽 /scan 지정)                   -->
    <!-- =================================================================== -->
    <gazebo reference="lidar_link">
        <sensor type="gpu_lidar" name="lidar_sensor">
            <always_on>true</always_on>
            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10.0</update_rate>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.10</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- =================================================================== -->
    <!-- 5. RealSense 카메라 센서 설정 (gz_frame_id 광학 좌표계 복원)         -->
    <!-- =================================================================== -->
    <gazebo reference="camera_link">
        <visual name="camera_link_visual">
            <material>
                <ambient>0.2 0.2 0.2 1.0</ambient>
                <diffuse>0.2 0.2 0.2 1.0</diffuse>
                <specular>0.2 0.2 0.2 1.0</specular>
            </material>
        </visual>
        <sensor type="camera" name="camera_sensor">
            <always_on>true</always_on>
            <topic>/camera/image_raw</topic>
            <gz_frame_id>camera_color_optical_frame</gz_frame_id>
            <update_rate>${update_rate}</update_rate>
            <visualize>true</visualize>
            <camera>
                <camera_info_topic>/camera/camera_info</camera_info_topic>
                <horizontal_fov>1.50098</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>
