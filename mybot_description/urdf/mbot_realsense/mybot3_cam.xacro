<?xml version="1.0"?>
<robot name="mybot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 하위 Gazebo 플러그인 및 RealSense 매크로 로드 -->
  <xacro:include filename="mybot.gazebo.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <xacro:property name="base_mass" value="50.0"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_length" value="0.925"/>
  <xacro:property name="base_height" value="0.21"/>

  <xacro:property name="wheel_radius" value="0.16459"/>
  <xacro:property name="wheel_length" value="0.11653"/>
  <xacro:property name="wheel_mass" value="8.0"/>

  <xacro:property name="wheel_offset_x" value="0.249"/>
  <xacro:property name="wheel_offset_y" value="0.29153"/>
  <xacro:property name="wheel_offset_z" value="-0.0702"/>

  <xacro:property name="lidar_radius" value="0.03"/>
  <xacro:property name="lidar_length" value="0.1"/>

  <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
  <material name="black"><color rgba="0.0 0.0 0.0 0.8"/></material>

  <!-- 바퀴 매크로 정의 -->
  <xacro:macro name="wheel" params="prefix wheel_type *origin *axis">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <mesh filename="package://mybot_description/meshes/${wheel_type}.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.570795 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_length*wheel_length)}" ixy="0" ixz="0"
                iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_length*wheel_length)}" iyz="0"
                izz="${(1/2) * wheel_mass * (wheel_radius*wheel_radius)}"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <xacro:insert_block name="origin"/>
      <xacro:insert_block name="axis"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <xacro:wheel_gazebo prefix="${prefix}"/>
  </xacro:macro>

  <xacro:wheel prefix="front_right" wheel_type="wheel_type1">
    <origin rpy="3.14 0 0" xyz="${wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}"/>
    <axis xyz="0 -1 0"/>
  </xacro:wheel>

  <xacro:wheel prefix="front_left" wheel_type="wheel_type2">
    <origin rpy="0 0 0" xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}"/>
    <axis xyz="0 1 0"/>
  </xacro:wheel>

  <xacro:wheel prefix="rear_left" wheel_type="wheel_type2">
    <origin rpy="0 0 0" xyz="${-wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}"/>
    <axis xyz="0 1 0"/>
  </xacro:wheel>

  <xacro:wheel prefix="rear_right" wheel_type="wheel_type1">
    <origin rpy="3.14 0 0" xyz="${-wheel_offset_x} ${-wheel_offset_y} ${wheel_offset_z}"/>
    <axis xyz="0 -1 0"/>
  </xacro:wheel>

  <!-- REP-120 표준: 루트 링크는 관성(Inertial) 없이 정의 -->
  <link name="base_footprint"/>

  <!-- 차체 베이스 링크 (물리 엔진의 메인 강체) -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mybot_description/meshes/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.008"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.035"/>
      <geometry>
        <box size="0.154 0.627 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0.0 0.0 0.015"/>
      <inertia ixx="${(1/12) * base_mass * (base_width*base_width + base_height*base_height)}" ixy="0" ixz="0"
               iyy="${(1/12) * base_mass * (base_length*base_length + base_height*base_height)}" iyz="0"
               izz="${(1/12) * base_mass * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2352" rpy="0 0 0"/>
  </joint>

  <!-- RealSense D435i 카메라 인스턴스화 -->
  <xacro:sensor_d435i parent="base_link" name="camera" use_nominal_extrinsics="true">
    <origin xyz="0.40 0.0 0.04" rpy="0 0 0"/>
  </xacro:sensor_d435i>

  <!-- 라이다 링크 및 조인트 -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${(1/12) * 0.1 * (3*lidar_radius*lidar_radius + lidar_length*lidar_length)}" ixy="0" ixz="0"
              iyy="${(1/12) * 0.1 * (3*lidar_radius*lidar_radius + lidar_length*lidar_length)}" iyz="0"
              izz="${(1/2) * 0.1 * (lidar_radius*lidar_radius)}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

</robot>
