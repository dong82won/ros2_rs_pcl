Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Value: Lines
      Plane: XY
      Reference Frame: camera_color_optical_frame

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Marker Scale: 0.15

    - Class: rviz_default_plugins/MarkerArray
      Name: Tag_3D_Marker
      Enabled: true
      Topic:
        Value: /rgbd_tag_fusion_node/target_tag_markers
        Depth: 5
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Pose
      Name: Target_Tag_Pose
      Enabled: true
      Topic:
        Value: /rgbd_tag_fusion_node/target_tag_pose
        Depth: 5
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.008

    - Class: rviz_default_plugins/Image
      Name: AR_Annotated_Image
      Enabled: true
      Topic:
        Value: /rgbd_tag_fusion_node/annotated_image
        Reliability Policy: Best Effort

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_color_optical_frame
    Frame Rate: 30

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.35
      Pitch: 0.35
      Yaw: 3.14
      Value: Orbit (rviz)
